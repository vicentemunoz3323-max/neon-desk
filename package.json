{
  "name": "neon-desk",
  "version": "1.0.1",
  "description": "Animación de escritorio de desarrollo web en Electron",
  "author": "Vicente M",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicentemunoz3323-max/neon-desk.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vicentem.neondesk",
    "productName": "Neon Desk",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "style.css"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vicentemunoz3323-max",
        "repo": "neon-desk",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
